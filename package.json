{
  "name": "ventaplay-scraper",
  "version": "1.1.1",
  "repository": "github:FelipeBurboa/agendaprogservicios",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "start": "npx tsx main.ts",
    "server": "npx tsx server.ts",
    "electron:build": "tsc -p tsconfig.json",
    "renderer:build": "cd renderer && npm run build",
    "electron:dev": "npm run electron:build && concurrently -k \"cd renderer && npm run dev\" \"node scripts/wait-and-launch.js\"",
    "electron:pack": "npm run electron:build && npm run renderer:build && electron-builder --win --publish never",
    "electron:pack:mac": "npm run electron:build && npm run renderer:build && electron-builder --mac --publish never",
    "electron:publish": "npm run electron:build && npm run renderer:build && electron-builder --win --publish always",
    "electron:publish:mac": "npm run electron:build && npm run renderer:build && electron-builder --mac --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@types/express": "^5.0.6",
    "@types/node": "^25.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ventaplay.scraper",
    "productName": "VentaPlay Extractor",
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "FelipeBurboa",
        "repo": "agendaprogservicios"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "identity": "-"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
